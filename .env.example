# Server-only OpenAI-compatible chat completions adapter. Keep the feature disabled
# until provider privacy terms, spending limits, and each Sanskrit target pair pass review.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MAX_OUTPUT_TOKENS=512
AI_ENABLED_LANGUAGE_PAIRS=

# Supabase Auth/Database (publishable/anon key only in the browser; never put the service role key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
